{
  "info": {
    "name": "Honeycomb + Example",
    "_postman_id": "",
    "description": "Combined Postman collection for the Honeycomb core app and the honeycomb-example project. Uses {{baseUrl}} plus headers for X-API-Key and shared auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Honeycomb Core",
      "item": [
        {
          "name": "List Models",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/honeycomb/models", "host": ["{{baseUrl}}"], "path": ["honeycomb", "models"] }
          },
          "response": []
        },
        {
          "name": "Describe Model",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/honeycomb/models/:name", "host": ["{{baseUrl}}"], "path": ["honeycomb", "models", ":name"] }
          },
          "response": []
        },
        {
          "name": "List Items (model)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/honeycomb/models/:name/items", "host": ["{{baseUrl}}"], "path": ["honeycomb", "models", ":name", "items"] }
          },
          "response": []
        },
        {
          "name": "Get Item",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/honeycomb/models/:name/items/:id", "host": ["{{baseUrl}}"], "path": ["honeycomb", "models", ":name", "items", ":id"] }
          },
          "response": []
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"item-1\",\n  \"name\": \"Example\",\n  \"value\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/honeycomb/models/:name/items", "host": ["{{baseUrl}}"], "path": ["honeycomb", "models", ":name", "items"] }
          },
          "response": []
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated\",\n  \"value\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/honeycomb/models/:name/items/:id", "host": ["{{baseUrl}}"], "path": ["honeycomb", "models", ":name", "items", ":id"] }
          },
          "response": []
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
