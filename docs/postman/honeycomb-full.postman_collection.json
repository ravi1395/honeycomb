            "body": {
              "mode": "raw",
              "raw": "{\n  \"example\": \"value\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/honeycomb/shared/:methodName", "host": ["{{baseUrl}}"], "path": ["honeycomb", "shared", ":methodName"] }
