    {
      "name": "Cell Routing",
      "item": [
        {
          "name": "Invoke Shared (route to cell instances)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payload\": {\"x\": 1}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cells/:from/invoke/:to/shared/:methodName?policy=round-robin",
              "host": ["{{baseUrl}}"],
              "path": ["cells", ":from", "invoke", ":to", "shared", ":methodName"],
              "query": [
                { "key": "policy", "value": "round-robin" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Forward Request to Cell",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payload\": {\"message\": \"hello\"}\n}"
            },
            "url": { "raw": "{{baseUrl}}/cells/:from/forward/:to", "host": ["{{baseUrl}}"], "path": ["cells", ":from", "forward", ":to"] }
          },
          "response": []
        }
      ]
    },
    {
