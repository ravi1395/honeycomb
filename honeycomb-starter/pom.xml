<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.honeycomb</groupId>
        <artifactId>honeycomb-parent</artifactId>
        <version>1.4.3</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Keep backward compatible coordinate: com.honeycomb:honeycomb -->
    <artifactId>honeycomb</artifactId>
    <packaging>jar</packaging>
    <name>honeycomb</name>

    <dependencies>
        <dependency>
            <groupId>com.honeycomb</groupId>
            <artifactId>honeycomb-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Optional gRPC transport module — pulled in when honeycomb.grpc.enabled=true -->
        <dependency>
            <groupId>com.honeycomb</groupId>
            <artifactId>honeycomb-grpc</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>
</project>
